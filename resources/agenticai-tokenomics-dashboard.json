          "expr": "sum by (api_key_alias)(litellm_spend_metric_total{api_key_alias=~\"agenticai-$cohort-u.*\"})",
          "refId": "E",
          "format": "table",
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-nuc"
          }
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "api_key_alias",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "renameByName": {
              "api_key_alias": "Participant",
              "Value #A": "Input tok",
              "Value #B": "Output tok",
              "Value #C": "Total tok",
              "Value #D": "Requests",
              "Value #E": "Spend $"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Total tok",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Spend $"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 5
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
